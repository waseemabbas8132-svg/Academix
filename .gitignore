# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Python environments and generated artifacts
.venv/
venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/

# Environment secrets; keep example templates tracked
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# AI datasets (retain directory markers and documentation)
/ai-engine/datasets/raw/**
/ai-engine/datasets/processed/**
!/ai-engine/datasets/raw/.gitkeep
!/ai-engine/datasets/processed/.gitkeep
!/ai-engine/datasets/raw/README.md
!/ai-engine/datasets/processed/README.md

# Model weights and checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
/ai-engine/models/*
!/ai-engine/models/.gitkeep

# Experiment outputs and caches
/ai-engine/runs/
/ai-engine/outputs/
/ai-engine/checkpoints/
/ai-engine/wandb/
/ai-engine/lightning_logs/
